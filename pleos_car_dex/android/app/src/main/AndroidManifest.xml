<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Android Automotive OS 앱 선언 -->
    <uses-feature android:name="android.hardware.type.automotive" android:required="true" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <uses-feature android:name="android.hardware.wifi" android:required="false" />
    <uses-feature android:name="android.hardware.screen.portrait" android:required="false" />
    <uses-feature android:name="android.hardware.screen.landscape" android:required="false" />

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.CAMERA" />
    <!-- Pleos FusedLocation SDK 권한 (런타임 요청 필요) -->
    <uses-permission android:name="pleos.car.permission.FUSED_LOCATION" />
    <!-- Pleos Vehicle SDK: 기어 상태(P단) -> 주행 중 화면 잠금 -->
    <uses-permission android:name="pleos.car.permission.CAR_DRIVE" />
    <!-- Pleos NaviHelper: 경로 요청(requestRoute / requestRouteWithWaypoints) -->
    <uses-permission android:name="pleos.car.permission.NAVI_ROUTE" />
    <uses-permission android:name="pleos.car.permission.NAVI_ROUTE_SEARCH" />

    <application
        android:label="@string/app_name"
        android:theme="@style/Theme.PleosCarDex"
        android:usesCleartextTraffic="true"
        android:networkSecurityConfig="@xml/network_security_config">

        <uses-library android:name="android.car" android:required="false" />

        <!-- 주행 중에도 표시 가능하도록 distraction-optimized 선언 (정책상 주행 중 UI 제한은 별도 검토) -->
        <meta-data android:name="distractionOptimized" android:value="true" />

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:screenOrientation="landscape">
            <meta-data android:name="distractionOptimized" android:value="true" />
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
