# ---- LLM (Claude) ----
# 키가 없거나 USE_MOCK_LLM=true 이면 카탈로그 기반 목업 응답으로 동작 (오프라인 시연용)
ANTHROPIC_API_KEY=
USE_MOCK_LLM=false
LLM_MODEL=claude-opus-5-5
# low | medium | high  (차량 UI 응답성을 위해 기본 low)
LLM_EFFORT=low

# ---- Vision ----
# yolo | mock   (YOLOv8n: 가볍고 빠름. mock: 이미지 전체를 차량 1대로 간주)
DETECTOR_MODE=yolo
YOLO_WEIGHTS=yolov8n.pt
YOLO_CONF=0.35
# llm | mock    (mock: 파일명/해시 기반으로 카탈로그 차량 선택)
IDENTIFIER_MODE=llm

# ---- Storage ----
DATA_DIR=./storage

# ---- Video ----
# 영상 입력 시 초당 분석 프레임 수 / 영상 1개당 카드로 만들 최대 차량 수
VIDEO_SAMPLE_FPS=2
VIDEO_MAX_VEHICLES=3

# ---- 한국관광공사 TourAPI (공공데이터포털 '국문 관광정보 서비스' 인증키, Decoding 키) ----
# 비우면 시연용 목업 명소/축제 데이터 사용
TOUR_API_KEY=
LANDMARK_RADIUS_M=500

# ---- 시연 도구: 앱 설정 탭의 '시연 데이터 채우기/초기화' (/api/v1/demo/*). 배포 시 false ----
DEMO_MODE=true
