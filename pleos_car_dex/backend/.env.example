# ---- LLM (Claude) ----
# 키가 없거나 USE_MOCK_LLM=true 이면 카탈로그 기반 목업 응답으로 동작 (오프라인 시연용)
ANTHROPIC_API_KEY=
USE_MOCK_LLM=false
LLM_MODEL=claude-opus-5-5
# low | medium | high  (차량 UI 응답성을 위해 기본 low)
LLM_EFFORT=low

# ---- Vision ----
# yolo | mock   (mock: 이미지 전체를 차량 1대로 간주)
DETECTOR_MODE=yolo
YOLO_WEIGHTS=yolo11n.pt
YOLO_CONF=0.35
# llm | mock    (mock: 파일명/해시 기반으로 카탈로그 차량 선택)
IDENTIFIER_MODE=llm

# ---- Storage ----
DATA_DIR=./storage
